rectangle "Celular del turista\n<size:10>[Deployment Node: Navegador web]</size>" <<Produccion.Celulardelturista>> as Produccion.Celulardelturista {
  rectangle "==Web del turista\n<size:10>[Container: React (SPA)]</size>\n\nBúsqueda de tours, reserva de una salida, registro del boleto turístico y pago." <<Produccion.Celulardelturista.Webdelturista_1>> as Produccion.Celulardelturista.Webdelturista_1
}

rectangle "Tablet o PC de la agencia\n<size:10>[Deployment Node: Navegador web con PWA instalada]</size>" <<Produccion.TabletoPCdelaagencia>> as Produccion.TabletoPCdelaagencia {
  rectangle "==Portal de agencias\n<size:10>[Container: React (PWA)]</size>\n\nPublicación de tours, fechas y cupos; reservas presenciales; aprobación de agencias y reportes de ventas." <<Produccion.TabletoPCdelaagencia.Portaldeagencias_1>> as Produccion.TabletoPCdelaagencia.Portaldeagencias_1
  database "==Almacén local sin conexión\n<size:10>[Container: IndexedDB (navegador)]</size>\n\nReservas presenciales pendientes de sincronizar, guardadas en el dispositivo de la agencia." <<Produccion.TabletoPCdelaagencia.Almacénlocalsinconexión_1>> as Produccion.TabletoPCdelaagencia.Almacénlocalsinconexión_1
}

rectangle "Proveedor cloud\n<size:10>[Deployment Node: Región del proveedor]</size>" <<Produccion.Proveedorcloud>> as Produccion.Proveedorcloud {
  rectangle "==Balanceador de carga\n<size:10>[Infrastructure Node: HTTPS (TLS)]</size>\n\nTermina TLS y reparte el tráfico entre las réplicas de la API." <<Produccion.Proveedorcloud.Balanceadordecarga>> as Produccion.Proveedorcloud.Balanceadordecarga
  rectangle "VM Ubuntu 24.04 (x2)\n<size:10>[Deployment Node: Ubuntu 24.04]</size>" <<Produccion.Proveedorcloud.VMUbuntu2404x2>> as Produccion.Proveedorcloud.VMUbuntu2404x2 {
