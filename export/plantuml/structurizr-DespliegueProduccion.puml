    }

  }

  rectangle "PostgreSQL gestionado\n<size:10>[Deployment Node: PostgreSQL 16]</size>" <<Produccion.Proveedorcloud.PostgreSQLgestionado>> as Produccion.Proveedorcloud.PostgreSQLgestionado {
    database "==Base de datos\n<size:10>[Container: PostgreSQL 16]</size>\n\nAgencias, tours, salidas, cupos, reservas, ventas y cola de validaciones diferidas (cola_validacion_boletos / Transactional Outbox). No guarda datos de tarjetas." <<Produccion.Proveedorcloud.PostgreSQLgestionado.Basededatos_1>> as Produccion.Proveedorcloud.PostgreSQLgestionado.Basededatos_1
  }

}

