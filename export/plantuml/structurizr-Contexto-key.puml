@startuml
set separator none

skinparam {
  shadowing false
  arrowFontSize 15
  defaultTextAlignment center
  wrapWidth 100
  maxMessageSize 100
}
hide stereotype

skinparam rectangle<<_transparent>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

skinparam person<<1>> {
  BackgroundColor #0b3d62
  FontColor #ffffff
  BorderColor #072a44
}
person "==Person" <<1>>

skinparam rectangle<<2>> {
  BackgroundColor #1b5e8b
  FontColor #ffffff
  BorderColor #124161
}
rectangle "==Software System" <<2>>

skinparam rectangle<<3>> {
  BackgroundColor #8c8c8c
  FontColor #ffffff
  BorderColor #626262
}
rectangle "==Software System, Externo" <<3>>

rectangle "." <<_transparent>> as 4
4 .[#707070,thickness=2].> 4 : "<color:#707070>Relationship"


@enduml