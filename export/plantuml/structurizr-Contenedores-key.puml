@startuml
set separator none

skinparam {
  shadowing false
  arrowFontSize 15
  defaultTextAlignment center
  wrapWidth 100
  maxMessageSize 100
}
hide stereotype

skinparam rectangle<<_transparent>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

skinparam rectangle<<1>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
}
rectangle "==Container" <<1>>

skinparam database<<2>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
}
database "==Container, Almacen" <<2>>

skinparam rectangle<<3>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
}
rectangle "==Container, WebBrowser" <<3>>

skinparam person<<4>> {
  BackgroundColor #0b3d62
  FontColor #ffffff
  BorderColor #072a44
}
person "==Person" <<4>>

skinparam rectangle<<5>> {
  BackgroundColor #8c8c8c
  FontColor #ffffff
  BorderColor #626262
}
rectangle "==Software System, Externo" <<5>>

rectangle "." <<_transparent>> as 6
6 .[#707070,thickness=2].> 6 : "<color:#707070>Relationship"


@enduml