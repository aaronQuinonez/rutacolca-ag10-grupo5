@startuml
set separator none
title Diagrama de contenedores de RutaColca con soporte sin conexión (HU-05)

top to bottom direction

skinparam {
  arrowFontSize 10
  defaultTextAlignment center
  wrapWidth 200
  maxMessageSize 100
}

hide stereotype

skinparam rectangle<<RutaColca.APIdeRutaColca>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
  shadowing false
}
skinparam person<<Administradordelconsorcio>> {
  BackgroundColor #0b3d62
  FontColor #ffffff
  BorderColor #072a44
  shadowing false
}
skinparam database<<RutaColca.Almacénlocalsinconexión>> {
  BackgroundColor #b25e00
  FontColor #ffffff
  BorderColor #7c4100
  shadowing false
}
skinparam database<<RutaColca.Basededatos>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
  shadowing false
}
skinparam person<<Operadordeagencia>> {
  BackgroundColor #0b3d62
  FontColor #ffffff
  BorderColor #072a44
  shadowing false
}
skinparam rectangle<<Pasareladepagos>> {
  BackgroundColor #8c8c8c
  FontColor #ffffff
  BorderColor #626262
  shadowing false
}
skinparam rectangle<<RutaColca.Portaldeagencias>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
  shadowing false
}
skinparam rectangle<<SistemadeAUTOCOLCA>> {
  BackgroundColor #8c8c8c
  FontColor #ffffff
  BorderColor #626262
  shadowing false
}
skinparam person<<Turista>> {
  BackgroundColor #0b3d62
  FontColor #ffffff
  BorderColor #072a44
  shadowing false
}
skinparam rectangle<<RutaColca.Webdelturista>> {
  BackgroundColor #0e7d73
  FontColor #ffffff
  BorderColor #095750
  shadowing false
}
skinparam rectangle<<WhatsAppBusiness>> {
  BackgroundColor #8c8c8c
  FontColor #ffffff
  BorderColor #626262
  shadowing false
}
